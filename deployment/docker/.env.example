POSTGRES_DB=support_knowledge_miner
POSTGRES_USER=support_knowledge_miner
POSTGRES_PASSWORD=replace-with-local-dev-password
POSTGRES_PORT=5432

# Optional Ollama runtime for local dynamic model loading.
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_PORT=11434
OLLAMA_GPU_COUNT=1
OLLAMA_KEEP_ALIVE=5m
SKM_OLLAMA_BASE_URL=http://localhost:11434
SKM_OLLAMA_MODELS=nomic-embed-text

# Required before saving OpenAI API keys. Generate a local value outside source
# control with: uv run --locked python -c "from backend.providers.secrets import generate_provider_secret_key; print(generate_provider_secret_key())"
SKM_PROVIDER_ENCRYPTION_KEY=

#SKM_INITIAL_PASSWORD=my-password
#SKM_INITIAL_EMAIL=e@mail.eu
#SKM_INITIAL_FIRST_NAME=Name
#SKM_INITIAL_LAST_NAME=Last Name
