# Local agent and verification overrides. The generated
# .ai/config/project.defaults.env is committed and is the CI source of truth.
.ai/config/project.env

# IntelliJ IDEA: keep personal/local state out of Git.
.idea/*
.idea/vcs.xml
.idea/workspace.xml
.idea/shelf/

# Other local IDE/agent state.
.vscode/
.cursor/
.claude/
.codex/

# Repository-native orchestrator runtime state and staged agent workspaces.
.ai/orchestration/
.ai/.orchestration.guard
.ai/orchestration-completed.json

# Common secrets and local environments
.env
.env.*
!.env.example
.venv/
venv/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build, test, and dependency output
build/
dist/
target/
coverage/
node_modules/

# Review artifacts generated by template update mode.
template-update.patch
template-update.manual.patch
.ai/template-update-plan.json
.ai/.template-update.lock
